# Variáveis para rodar localmente (npm run dev, npm run migrate, npm run test:integration).
# Valores fictícios de uso local. Na AWS, o Terraform preenche as variáveis de cada Lambda.

FIAPX_ENV=local
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
PORT=3001

# Opcionais: sem elas, os valores vêm do SSM em /fiapx/<FIAPX_ENV>/...
# DB_SECRET_ARN=
# DB_HOST=            # sobrescreve o host do segredo (ex.: "mysql" dentro do compose)
# DB_PORT=
# JWT_PRIVATE_KEY_SECRET_ARN=
# JWT_PUBLIC_KEY=
# NOTIFICATION_QUEUE_URL=
# WEB_URL=
